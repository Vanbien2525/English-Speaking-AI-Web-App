# Copy to `.env` and replace placeholders. NEVER commit the real `.env`.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=speaking_tutor_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:your_secure_password@127.0.0.1:5432/speaking_tutor_db

# --- AI Speech Engine (Python FastAPI, services/ai-engine) ---
# Provider: local | gemini | azure
AI_ENGINE_PROVIDER=local
AI_ENGINE_URL=http://127.0.0.1:8000
AI_ENGINE_TIMEOUT_MS=5000

# --- Optional cloud providers (only when AI_ENGINE_PROVIDER != local) ---
GEMINI_API_KEY=your_gemini_api_key_here
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here
